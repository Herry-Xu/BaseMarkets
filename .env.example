# Network Configuration
NET=testnet
NODE_URL=https://base-mainnet.infura.io/v3/your_infura_project_id
PRIVATE_KEY=your_private_key_here
CHAINLINK_CONTRACT_ADDRESS=0x...

# Chain Configuration
CHAIN_ID=8453  # Base Mainnet (84532 for testnet)
RPC_URL=https://mainnet.base.org

# Contract Addresses (will be set after deployment)
PREDICTION_ADDRESS=0x...

# API Keys
BASESCAN_API_KEY=your_basescan_api_key  # Required for contract verification

# Service Configuration
PORT=8080
